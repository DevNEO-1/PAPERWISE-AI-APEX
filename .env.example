# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Authoritative Gemini Model (Default: gemini-3.5-flash-lite)
# Active Fallback Cascade: gemini-3.8-flash, gemini-3.1-flash-lite, gemini-3.1-pro-preview
# Project policy: Gemini 1.5, 2.0, and 2.5 model families are intentionally excluded from this fallback allowlist.
# This policy exclusion does not mean every Gemini 2.5 model is officially deprecated or shut down.
GEMINI_MODEL=gemini-3.5-flash-lite

# Document Boundaries & Chunking
MAX_FILE_SIZE_MB=30
MAX_PAGE_COUNT=60
MIN_WORD_COUNT_THRESHOLD=50
CHUNK_PAGE_SIZE=5
SYNTHESIS_PAGE_THRESHOLD=8
